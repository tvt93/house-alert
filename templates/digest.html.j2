<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ subject }}</title>
</head>
{#
  Email HTML, not web HTML: tables for layout, styles inline, no external
  assets except the listing photos themselves. Gmail strips <style> blocks in
  some clients, so nothing structural may depend on the one below.
#}
<body style="margin:0;padding:0;background:#f4f4f2;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#1c1c1a;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f4f4f2;">
<tr><td align="center" style="padding:24px 12px;">

<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;">

  <!-- header -->
  <tr><td style="padding:0 4px 16px;">
    <div style="font-size:20px;font-weight:700;letter-spacing:-0.2px;">
      {{ listings|length }} nieuwe {{ 'woning' if listings|length == 1 else 'woningen' }}
    </div>
    <div style="font-size:13px;color:#6b6b66;padding-top:4px;">
      {{ run_date }}{% if label %} &middot; {{ label }}{% endif %} &middot; {{ agency_count }} kantoren gescand{% if scan_errors %} &middot; {{ scan_errors }} niet bereikbaar{% endif %}
    </div>
  </td></tr>

  {% for listing in listings %}
  <!-- card -->
  <tr><td style="padding:0 0 16px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
           style="background:#ffffff;border-radius:10px;overflow:hidden;border:1px solid #e2e2dd;">

      {% if listing.image_url %}
      <tr><td style="padding:0;">
        <a href="{{ listing.url }}" style="text-decoration:none;">
          <img src="{{ listing.image_url }}" alt="" width="600"
               style="display:block;width:100%;max-width:600px;height:auto;border:0;">
        </a>
      </td></tr>
      {% endif %}

      <tr><td style="padding:16px 18px 18px;">

        <div style="font-size:19px;font-weight:700;color:#1c1c1a;">
          {{ listing.price_display }}
        </div>

        <div style="font-size:15px;font-weight:600;padding-top:6px;line-height:1.35;">
          <a href="{{ listing.url }}" style="color:#1c1c1a;text-decoration:none;">
            {{ listing.title|truncate(90) or listing.url }}
          </a>
        </div>

        {% if listing.location_display %}
        <div style="font-size:13px;color:#6b6b66;padding-top:4px;">
          {{ listing.location_display }}
        </div>
        {% endif %}

        {% if listing.facts() %}
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="padding-top:12px;">
          <tr>
            {% for label, value in listing.facts() %}
            <td style="padding:0 16px 0 0;vertical-align:top;">
              <div style="font-size:11px;color:#8a8a84;text-transform:uppercase;letter-spacing:0.5px;">{{ label }}</div>
              <div style="font-size:14px;font-weight:600;padding-top:2px;">{{ value }}</div>
            </td>
            {% endfor %}
          </tr>
        </table>
        {% endif %}

        {% if listing.matched_keywords %}
        <div style="padding-top:12px;">
          {% for word in listing.matched_keywords %}
          <span style="display:inline-block;font-size:11px;font-weight:600;color:#2f5d3a;background:#e8f2e9;border-radius:99px;padding:3px 9px;margin:0 4px 4px 0;">{{ word }}</span>
          {% endfor %}
        </div>
        {% endif %}

        {% if listing.description %}
        <div style="font-size:13px;color:#4a4a45;line-height:1.5;padding-top:12px;">
          {{ listing.description|truncate(220) }}
        </div>
        {% endif %}

        <div style="padding-top:16px;">
          <a href="{{ listing.url }}"
             style="display:inline-block;background:#1c1c1a;color:#ffffff;text-decoration:none;font-size:13px;font-weight:600;padding:9px 16px;border-radius:6px;">
            Bekijk op {{ listing.source|truncate(28) }} &rarr;
          </a>
        </div>

      </td></tr>
    </table>
  </td></tr>
  {% endfor %}

  <!-- footer -->
  <tr><td style="padding:8px 4px 0;font-size:12px;color:#8a8a84;line-height:1.6;">
    house-alert &middot; {{ candidate_count }} advertenties bekeken, {{ listings|length }} door de filter.<br>
    {% if site_url %}
    Alle woningen op kaart en in lijst: <a href="{{ site_url }}" style="color:#1c1c1a;">{{ site_url }}</a><br>
    {% endif %}
    Filters aanpassen: <code style="font-family:ui-monospace,Menlo,Consolas,monospace;">config/subscriptions/</code>.
    Kantoor toevoegen: <code style="font-family:ui-monospace,Menlo,Consolas,monospace;">config/agencies.yaml</code>.
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
